# Tech AI Zone & TrendPulse AI Configuration
PORT=3000
SITE_URL=http://localhost:3000
SITE_NAME="Tech AI Zone"
SITE_DESCRIPTION="The authoritative pulse of breakthrough AI tools, next-gen hardware, and viral tech innovations."
ADMIN_PASSWORD=admin123

# Groq API Keys (Supports multiple keys separated by commas for automatic rate-limit rotation pool)
# e.g. GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
GROQ_API_KEYS=

# Primary Groq Model
GROQ_MODEL=llama-3.3-70b-versatile

# Publishing Schedule (Cron format: Default 4x daily: 08:00, 12:00, 16:00, 20:00)
PUBLISH_CRON="0 8,12,16,20 * * *"
AUTO_PUBLISH_ENABLED=true

# AdSense Configuration
ADSENSE_CLIENT_ID=
ADS_ENABLED=false

# Google Search Console Verification Token (Optional)
GOOGLE_SITE_VERIFICATION=
