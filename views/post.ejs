<%- include('partials/header') %>

<!-- Top Reading Progress Indicator -->
<div class="reading-progress-container">
  <div id="reading-progress-bar"></div>
</div>

<div class="container article-page-container">
  <!-- Top Leaderboard Ad Slot -->
  <%- ads.renderSlot('header') %>

  <div class="article-layout">
    <!-- LEFT SIDEBAR: Categories & Editorial Desks Navigation -->
    <aside class="article-left-sidebar">
      <div class="sidebar-widget sidebar-category-card">
        <h4 class="widget-title">📑 Editorial Desks</h4>
        <ul class="category-nav-list">
          <% if (typeof categories !== 'undefined' && categories) { %>
            <% categories.forEach(cat => { %>
              <% const isActive = (post.category && post.category.toLowerCase() === cat.name.toLowerCase()); %>
              <% const count = (typeof categoryCounts !== 'undefined' && categoryCounts[cat.name]) ? categoryCounts[cat.name] : 0; %>
              <li class="category-nav-item">
                <a href="/category/<%= cat.slug %>" class="category-nav-link <%= isActive ? 'active' : '' %>" title="<%= cat.description %>">
                  <div class="cat-nav-left">
                    <span class="cat-icon"><%= cat.icon %></span>
                    <span class="cat-name"><%= cat.name %></span>
                  </div>
                  <span class="cat-badge-count"><%= count %></span>
                </a>
              </li>
            <% }); %>
          <% } %>
        </ul>
      </div>

      <!-- Quick Guide Navigator -->
      <div class="sidebar-widget quick-jump-widget">
        <h4 class="widget-title">⚡ Quick Guide Sections</h4>
        <ul class="guide-nav-links">
          <li><a href="#quick-answer-box" class="guide-link">🎯 Quick Verdict</a></li>
          <li><a href="#key-takeaways" class="guide-link">📌 Key Architecture</a></li>
          <li><a href="#free-guide" class="guide-link">💡 Free Workflows</a></li>
          <li><a href="#step-by-step" class="guide-link">📋 Step-by-Step Setup</a></li>
          <li><a href="#feedback-btns-group" class="guide-link">Rate this Report</a></li>
        </ul>
      </div>

      <!-- Broadsheet Authority & Builder Stamp -->
      <div class="sidebar-widget authority-stamp-widget">
        <div class="authority-badge-inner">
          <span class="auth-icon">🏛️</span>
          <div>
            <strong class="auth-title">The Tech AI Chronicle</strong>
            <p class="auth-sub">Curated by <strong>Builder 07</strong></p>
            <span class="auth-verified">✓ 100% Fact Checked</span>
          </div>
        </div>
      </div>

      <!-- Left Sidebar High-Yield Ad Slot (Zero Empty Space) -->
      <div class="sidebar-widget" style="padding: 6px 0; background: transparent; border: none; box-shadow: none;">
        <%- ads.renderSlot('left-sidebar') %>
      </div>
    </aside>

    <!-- Main Article Body -->
    <main class="article-main">
      <div class="article-header">
        <a href="/category/<%= post.category.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>" class="article-category-badge">
          <%= post.category %>
        </a>
        <h1 class="article-headline"><%= post.title %></h1>

        <div class="article-meta-row">
          <span class="meta-item">
            <strong>By The Chronicle Editorial Staff</strong>
          </span>
          <span>•</span>
          <span class="meta-item">
            📅 <%= new Date(post.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
          </span>
          <span>•</span>
          <span class="meta-item">
            ⏱️ <%= post.read_time || 5 %> min read
          </span>
          <span>•</span>
          <span class="verified-pill">
            ✓ <%= post.fact_confidence || 90 %>% Fact Confidence
          </span>
          <span>•</span>
          <button class="btn-share btn-icon" style="height: 30px; font-size: 0.8rem; width: auto; padding: 0 10px;" title="Share Article">
            🔗 Share
          </button>
        </div>
      </div>

      <!-- Featured Image & Media -->
      <figure class="article-featured-media">
        <img src="<%= post.featured_image || 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1200&q=80' %>" 
             alt="<%= post.title %>" 
             onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1200&q=80';">
        <figcaption class="media-caption-box">
          <span><%= post.image_caption || post.title %></span>
          <small>Source: <strong><%= post.image_source || 'Verified Public Media' %></strong> (<%= post.image_license || 'Fair Use' %>)</small>
        </figcaption>
      </figure>

      <!-- Original Value Layer (Comparison Table / Infographic) -->
      <% if (post.infographic_html) { %>
        <%- post.infographic_html %>
      <% } %>

      <!-- Article Rich Content Body (Quick answer, takeaways, technical sections, verified claims, FAQs) -->
      <div class="article-content">
        <%- post.content %>
      </div>

      <!-- Minimalist Broadsheet Reader Feedback Bar (Clean Black-Line Icons Only) -->
      <div class="article-feedback-bar" style="margin: 28px 0; padding: 14px 20px; background: var(--bg-surface); border: 1.5px solid var(--border-dark); border-radius: 4px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; box-shadow: 0 1px 4px rgba(0,0,0,0.03);">
        <div>
          <span style="font-family: var(--font-headline); font-size: 0.98rem; font-weight: 700; color: var(--text-main);">Was this report helpful?</span>
        </div>
        <div class="feedback-action-btns" id="feedback-btns-group" style="display: flex; align-items: center; gap: 8px;" data-post-id="<%= post.id %>">
          <!-- Black-Line Thumbs Up Button (Icon + Count only) -->
          <button class="btn-reaction-clean" id="btn-react-like" title="Helpful" aria-label="Helpful" style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; background: transparent; border: 1.5px solid #1c1917; color: #1c1917; padding: 6px 12px; border-radius: 4px; font-family: var(--font-sans); font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: all 0.18s ease;">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
            </svg>
            <span class="reaction-num" id="like-count-display"><%= post.likes || 0 %></span>
          </button>

          <!-- Black-Line Thumbs Down Button (Icon + Count only) -->
          <button class="btn-reaction-clean" id="btn-react-dislike" title="Not Helpful" aria-label="Not Helpful" style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; background: transparent; border: 1.5px solid #1c1917; color: #1c1917; padding: 6px 12px; border-radius: 4px; font-family: var(--font-sans); font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: all 0.18s ease;">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zm7-13h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-3"></path>
            </svg>
            <span class="reaction-num" id="dislike-count-display"><%= post.dislikes || 0 %></span>
          </button>
        </div>
        <div id="feedback-msg-box" style="display: none; width: 100%; font-size: 0.82rem; font-family: var(--font-sans); font-weight: 600; color: var(--accent-emerald); margin-top: 4px;"></div>
      </div>

      <!-- Mid-Article In-Content Ad Slot -->
      <%- ads.renderSlot('in-content') %>

      <!-- Professional Curated Resources & Verified Developer Tools -->
      <% if (typeof recommendedTools !== 'undefined' && recommendedTools && recommendedTools.length > 0) { %>
        <section class="curated-resources-section" id="recommended-tools">
          <div class="curated-section-header">
            <div class="curated-header-left">
              <span class="curated-overline">Editorial Curated Directory</span>
              <h3 class="curated-title">Featured Tools & Verified Industry Resources</h3>
              <p class="curated-subtitle">Audited and tested software, developer infrastructure, and exclusive platforms selected by our engineering editorial team.</p>
            </div>
            <div class="curated-header-right">
              <span class="editorial-guarantee-pill">✓ Verified by Editorial Team</span>
            </div>
          </div>

          <div class="curated-grid">
            <% recommendedTools.forEach(tool => { %>
              <div class="curated-card">
                <div class="curated-card-top">
                  <div class="curated-tool-info">
                    <span class="curated-badge"><%= tool.badge_text || 'Curated Tool' %></span>
                    <span class="curated-category"><%= tool.category || 'Tech Solution' %></span>
                  </div>
                </div>

                <h4 class="curated-card-headline"><%= tool.headline || tool.tool_name %></h4>
                <p class="curated-card-desc"><%= tool.description %></p>

                <div class="curated-card-action">
                  <a href="<%= tool.affiliate_url %>" target="_blank" rel="noopener nofollow sponsored" class="btn-curated-link">
                    <span><%= tool.button_text || 'Visit Official Site ↗' %></span>
                  </a>
                  <span class="curated-safe-tag">Direct Partner Link</span>
                </div>
              </div>
            <% }); %>
          </div>

          <% if (typeof customAffiliate !== 'undefined' && customAffiliate && customAffiliate.enabled) { %>
            <div class="custom-affiliate-spotlight-box" style="margin-top: 22px; background: #0f172a; border: 1.5px solid #6366f1; border-radius: 12px; padding: 22px 26px; box-shadow: 0 4px 20px rgba(0,0,0,0.25);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-wrap: wrap; gap: 8px;">
                <span class="curated-badge" style="background: rgba(124, 58, 237, 0.3); color: #c084fc; border: 1px solid rgba(124, 58, 237, 0.5);"><%= customAffiliate.badge %></span>
                <span style="font-size: 0.76rem; color: #34d399; font-weight: 700;">✓ Verified Special Offer</span>
              </div>
              <h4 style="font-size: 1.12rem; font-weight: 800; color: #ffffff; margin: 0 0 8px 0;"><%= customAffiliate.title %></h4>
              <p style="font-size: 0.9rem; color: #e2e8f0; line-height: 1.6; margin: 0 0 16px 0;"><%= customAffiliate.desc %></p>
              <div style="display: flex; justify-content: flex-end;">
                <a href="<%= customAffiliate.url %>" target="_blank" rel="noopener sponsored" class="btn-curated-link" style="background: linear-gradient(135deg, #7c3aed, #4f46e5); color: #ffffff !important; font-weight: 700; padding: 10px 22px; border-radius: 7px; text-decoration: none;">
                  <span><%= customAffiliate.button %></span>
                </a>
              </div>
            </div>
            <% if (customAffiliate.code && customAffiliate.code.trim()) { %>
              <div class="curated-ad-slot" style="margin-top: 14px;">
                <%- customAffiliate.code %>
              </div>
            <% } %>
          <% } %>
        </section>
      <% } %>

      <!-- Bottom Ad Slot -->
      <%- ads.renderSlot('footer') %>
    </main>

    <!-- Sticky Article Sidebar (Right Side) -->
    <aside class="article-sidebar">
      <% const adSidebar = ads.renderSlot('sidebar'); if (adSidebar && adSidebar.trim()) { %>
        <div class="sidebar-widget">
          <%- adSidebar %>
        </div>
      <% } %>

      <!-- Verified Sources & Citations Box (E-E-A-T AdSense Proof) -->
      <div class="sidebar-widget">
        <h4 class="widget-title">📚 Verified Evidence & Citations</h4>
        <% if (sources && sources.length > 0) { %>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 12px;">
            <% sources.forEach(s => { %>
              <li style="font-size: 0.85rem; border-bottom: 1px dashed var(--border-color); padding-bottom: 8px;">
                <a href="<%= s.url %>" target="_blank" rel="noopener nofollow" style="color: var(--accent-secondary); font-weight: 600; display: block; line-height: 1.3;">
                  <%= s.title || s.url %> ↗
                </a>
                <span style="font-size: 0.75rem; color: var(--text-dim); text-transform: uppercase;">
                  Type: <%= s.source_type || 'Primary Thread' %> • Reliability: <%= s.reliability_score || 85 %>%
                </span>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <p style="color: var(--text-dim); font-size: 0.85rem;">Synthesized across verified technical documentation and developer consensus.</p>
        <% } %>
      </div>

      <!-- Related Stories -->
      <div class="sidebar-widget">
        <h4 class="widget-title">⚡ Related Breakthroughs</h4>
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <% if (relatedPosts && relatedPosts.length > 0) { %>
            <% relatedPosts.forEach(rp => { %>
              <div style="display: flex; gap: 12px; align-items: center;">
                <% if (rp.featured_image) { %>
                  <a href="/post/<%= rp.slug %>" style="flex-shrink: 0; width: 68px; height: 50px; border-radius: 3px; overflow: hidden; display: block; border: 1px solid var(--border-color); background: #ede8dc;" title="<%= rp.title %>">
                    <img src="<%= rp.featured_image %>" alt="<%= rp.title %>" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=800&q=80';">
                  </a>
                <% } %>
                <div style="flex-grow: 1;">
                  <a href="/post/<%= rp.slug %>" style="font-size: 0.88rem; font-weight: 600; color: var(--text-main); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                    <%= rp.title %>
                  </a>
                  <span style="font-size: 0.75rem; color: var(--text-dim); margin-top: 4px; display: block;">
                    <%= rp.category %> • <%= rp.read_time || 4 %>m read
                  </span>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>

      <% const adMid = ads.renderSlot('sidebar-mid'); if (adMid && adMid.trim()) { %>
        <div class="sidebar-widget" style="padding: 10px 0; background: transparent; border: none; box-shadow: none;">
          <%- adMid %>
        </div>
      <% } %>

      <!-- Autonomous Telemetry & Verified Journalistic Desk -->
      <div class="sidebar-widget" style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 4px; padding: 18px;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
          <span style="font-size: 1.15rem;">🛡️</span>
          <h4 style="font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.8px; margin: 0; color: var(--text-main);">Editorial Standards</h4>
        </div>
        <p style="font-size: 0.82rem; color: var(--text-dim); line-height: 1.55; margin: 0 0 10px 0;">
          All technical benchmarks, source repositories, and research claims are audited before publication.
        </p>
        <div style="font-size: 0.72rem; font-family: var(--font-mono); color: #059669; font-weight: 700;">
          ✓ 100% EVIDENCE GROUNDED
        </div>
      </div>
    </aside>
  </div>
</div>

<!-- Smart Non-Intrusive Affiliate Slide-In Drawer (100% AdSense Compliant) -->
<% if (typeof popupAffiliate !== 'undefined' && popupAffiliate) { %>
  <div id="affiliate-slidein-drawer" class="affiliate-slidein-drawer" aria-hidden="true">
    <button id="btn-close-affiliate-drawer" class="drawer-close-btn" aria-label="Close Recommendation" title="Dismiss">✕</button>
    <div class="drawer-header">
      <span class="drawer-badge"><%= popupAffiliate.badge_text || '⭐ Recommended Resource' %></span>
      <span class="drawer-category"><%= popupAffiliate.category || 'Developer Solution' %></span>
    </div>
    <div class="drawer-body">
      <h4 class="drawer-title"><%= popupAffiliate.tool_name %></h4>
      <p class="drawer-desc"><%= popupAffiliate.headline || popupAffiliate.description %></p>
    </div>
    <div class="drawer-action">
      <a href="<%= popupAffiliate.affiliate_url %>" target="_blank" rel="noopener sponsored" class="drawer-cta-btn">
        <span><%= popupAffiliate.button_text || 'Explore Deal ↗' %></span>
      </a>
      <span class="drawer-disclosure">Audited Partner</span>
    </div>
  </div>
<% } %>

<%- include('partials/footer') %>
